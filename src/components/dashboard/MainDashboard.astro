---
---

<div class="space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
      <p class="text-muted-foreground">Welcome back! Here's what's happening with your projects today.</p>
    </div>
    <div class="flex items-center gap-2">
      <button class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Export
      </button>
      <button class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        New Project
      </button>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <!-- Total Projects -->
    <div class="card p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Total Projects</p>
          <p class="text-2xl font-bold">42</p>
          <p class="text-xs text-muted-foreground">
            <span class="text-green-600">+12%</span> from last month
          </p>
        </div>
        <div class="h-12 w-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-blue-600 dark:text-blue-400">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Active Projects -->
    <div class="card p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Active Projects</p>
          <p class="text-2xl font-bold">18</p>
          <p class="text-xs text-muted-foreground">
            <span class="text-green-600">+8%</span> from last month
          </p>
        </div>
        <div class="h-12 w-12 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-green-600 dark:text-green-400">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Completed Projects -->
    <div class="card p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Completed</p>
          <p class="text-2xl font-bold">21</p>
          <p class="text-xs text-muted-foreground">
            <span class="text-green-600">+15%</span> this year
          </p>
        </div>
        <div class="h-12 w-12 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-purple-600 dark:text-purple-400">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Delayed Projects -->
    <div class="card p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Delayed</p>
          <p class="text-2xl font-bold">3</p>
          <p class="text-xs text-muted-foreground">
            <span class="text-red-600">-2%</span> from last month
          </p>
        </div>
        <div class="h-12 w-12 rounded-lg bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-red-600 dark:text-red-400">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="grid gap-4 md:grid-cols-2">
    <!-- Project Progress -->
    <div class="card p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Project Progress</h3>
        <button class="text-sm text-muted-foreground hover:text-foreground">View all</button>
      </div>
      <div class="space-y-4">
        <div>
          <div class="mb-1 flex justify-between text-sm">
            <span>E-commerce Mobile App</span>
            <span class="text-muted-foreground">75%</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-secondary">
            <div class="h-full w-3/4 rounded-full bg-primary"></div>
          </div>
        </div>
        <div>
          <div class="mb-1 flex justify-between text-sm">
            <span>Banking Dashboard Redesign</span>
            <span class="text-muted-foreground">60%</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-secondary">
            <div class="h-full w-3/5 rounded-full bg-primary"></div>
          </div>
        </div>
        <div>
          <div class="mb-1 flex justify-between text-sm">
            <span>Travel Website</span>
            <span class="text-muted-foreground">45%</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-secondary">
            <div class="h-full w-2/5 rounded-full bg-primary"></div>
          </div>
        </div>
        <div>
          <div class="mb-1 flex justify-between text-sm">
            <span>Restaurant POS System</span>
            <span class="text-muted-foreground">90%</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-secondary">
            <div class="h-full w-11/12 rounded-full bg-primary"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Distribution -->
    <div class="card p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Status Distribution</h3>
        <button class="text-sm text-muted-foreground hover:text-foreground">View all</button>
      </div>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-blue-500"></div>
            <span class="text-sm">In Progress</span>
          </div>
          <span class="text-sm font-medium">18</span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
            <span class="text-sm">Review</span>
          </div>
          <span class="text-sm font-medium">7</span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-green-500"></div>
            <span class="text-sm">Completed</span>
          </div>
          <span class="text-sm font-medium">21</span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-red-500"></div>
            <span class="text-sm">On Hold</span>
          </div>
          <span class="text-sm font-medium">3</span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-gray-500"></div>
            <span class="text-sm">Backlog</span>
          </div>
          <span class="text-sm font-medium">12</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="card p-6">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="text-lg font-semibold">Recent Activity</h3>
      <button class="text-sm text-muted-foreground hover:text-foreground">View all</button>
    </div>
    <div class="space-y-4">
      <div class="flex items-start gap-4">
        <div class="h-10 w-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-blue-600 dark:text-blue-400">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="text-sm font-medium">New project created</p>
          <p class="text-sm text-muted-foreground">E-commerce Mobile App for TechCorp</p>
          <p class="text-xs text-muted-foreground">2 hours ago</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="h-10 w-10 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-green-600 dark:text-green-400">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="text-sm font-medium">Task completed</p>
          <p class="text-sm text-muted-foreground">Banking Dashboard wireframes completed</p>
          <p class="text-xs text-muted-foreground">5 hours ago</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="h-10 w-10 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-purple-600 dark:text-purple-400">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="text-sm font-medium">New client added</p>
          <p class="text-sm text-muted-foreground">TechCorp Inc. has been added as a client</p>
          <p class="text-xs text-muted-foreground">1 day ago</p>
        </div>
      </div>
    </div>
  </div>
</div>
